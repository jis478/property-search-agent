# Required for Phase 3+ (LangGraph agent):
OPENAI_API_KEY=sk-...

# Required for Phase 4+ (observability via Langfuse, optional):
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
